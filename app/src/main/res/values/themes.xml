<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ===== KasirPro Themes — Material Design 3 ===== -->

    <!-- Splash / activation theme (no action bar) -->
    <style name="Theme.KasirPro.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Main theme — Material 3 with custom color scheme -->
    <style name="Theme.KasirPro" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary / secondary / tertiary (MD3 color roles) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/surface</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>

        <!-- System bars -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Light variant -->
    <style name="Theme.KasirPro.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <!-- Typography styles -->
    <style name="TextAppearance.KasirPro.Heading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.KasirPro.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.KasirPro.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
